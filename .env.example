# DataHub metadata service. Quickstart maps host port 8081 to container port 8080.
DATAHUB_GMS_URL=http://localhost:8081

# DataHub web UI used to construct clickable entity links.
DATAHUB_FRONTEND_URL=http://localhost:9002

# Optional DataHub personal access token; leave empty for an unauthenticated quickstart.
DATAHUB_GMS_TOKEN=

# Optional OpenAI key; later slices degrade gracefully when it is absent.
OPENAI_API_KEY=

# OpenAI model used by the reasoning layer added in a later slice.
OPENAI_MODEL=gpt-5.6-sol

# PR delivery mode: dry-run is safe by default; use live only intentionally.
REPAIR_AGENT_PR_MODE=dry-run

# GitHub repository containing the demo warehouse code.
GITHUB_REPO=yadneshSalvi/datahub-repair-agent

# FastAPI port reserved for the repair-agent backend.
API_PORT=8002

